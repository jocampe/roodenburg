DATABASE_URL=postgresql://roodenburg:roodenburg@127.0.0.1:5432/roodenburg
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PREVIEW_SECRET=replace-with-an-independent-preview-secret
CONTACT_RETENTION_DAYS=180
# Purge is deliberately a dry run unless this exact opt-in is set on the scheduled job.
RETENTION_PURGE_CONFIRM=false

# Only trust this header when the app is unreachable except through the named reverse proxy/CDN.
TRUST_PROXY_HEADERS=false
PROXY_IP_HEADER=x-forwarded-for
# Require and attest a shared edge/WAF rate limit before reporting production readiness.
EDGE_RATE_LIMIT_REQUIRED=false
EDGE_RATE_LIMIT_VERIFIED=false

# Optional external analytics dashboard surfaced from the CMS home screen.
ANALYTICS_PROVIDER=
ANALYTICS_DASHBOARD_URL=

# S3-compatible media storage. Production should set S3_REQUIRED=true.
S3_REQUIRED=false
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Transactional email. Production should set SMTP_REQUIRED=true.
SMTP_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=website@lvroodenburg.nl
SMTP_FROM_NAME=L.V. Roodenburg
SMTP_REPLY_TO=info@lvroodenburg.nl
SMTP_SKIP_VERIFY=false
# Optional safety redirect for pre-production delivery testing.
SMTP_OVERRIDE_RECIPIENT=
CONTACT_NOTIFICATION_TO=
MEMBER_NOTIFICATION_TO=

# Normalized Sportlink snapshot endpoint. See docs/SPORTLINK_INTEGRATION.md.
SPORTLINK_API_URL=
SPORTLINK_API_KEY=
SPORTLINK_AUTH_HEADER=Authorization
SPORTLINK_AUTH_SCHEME=Bearer
SPORTLINK_TIMEOUT_MS=30000
FOOTBALL_SNAPSHOT_RETENTION=3
